NODE_ENV=development
HOST=127.0.0.1
PORT=5001
FRONTEND_URL=http://localhost:5174
# Production: NODE_ENV=production, HOST=0.0.0.0, FRONTEND_URL=https://app.vaniillaa.com
# Configure credentials only in local ignored environment files or the hosting dashboard.
DATABASE_URL=
# For TLS-required providers use their verified TLS connection settings (for example sslmode=verify-full).
# Never use rejectUnauthorized=false/no-verify to mask certificate errors.
JWT_SECRET=
# Exactly 32 random bytes encoded as base64; retain for queued mail recovery.
OUTBOX_ENCRYPTION_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Operator-only, temporary: existing Google subject to promote using npm run admin:bootstrap.
INITIAL_ADMIN_GOOGLE_SUB=
# Tests ONLY: a separate database whose name starts with attend_test.
TEST_DATABASE_URL=
# Legacy/recovery tools ONLY; never used by production startup:
# DB_PATH=/path/to/an/actual/legacy-backup.db
