NODE_ENV=development
HOST=127.0.0.1
PORT=5001
FRONTEND_URL=http://localhost:5174

# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep this key: changing it prevents decryption of already queued mail.
OUTBOX_ENCRYPTION_KEY=

# Optional absolute path; default is backend/db/attendance.db.
# DB_PATH=/absolute/path/to/attendance.db

# Delivery worker integration is a separate step; this backend currently queues mail only.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Google Sign-In is disabled until at least one client ID is set. Client IDs are public identifiers,
# but do not commit production environment files. Create separate Web, iOS, and Android clients in one Google Cloud project.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
