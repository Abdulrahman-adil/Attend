{
  "name": "geo-attendance-backend",
  "version": "1.0.0",
  "description": "Backend for the Geo-Attendance Pro application.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:check": "node scripts/postgres.js --check",
    "db:migrate": "node scripts/postgres.js --migrate",
    "test": "node --test tests/unit/*.test.js",
    "db:baseline": "node scripts/postgres.js --baseline",
    "admin:bootstrap": "node scripts/bootstrap-admin.js",
    "legacy:check": "node scripts/database.js --check",
    "legacy:migrate": "node scripts/database.js",
    "test:postgres": "node --test tests/*.test.js",
    "test:legacy": "node --test tests/legacy/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.10",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.1",
    "resend": "^6.4.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "supertest": "^7.2.2",
    "sqlite3": "^5.1.6"
